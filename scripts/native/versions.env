# Pinned native dependency versions for Android XMRig (#134).
# Do not use floating "latest" tags. Bump only with intentional hash updates.

XMRIG_VERSION=v6.21.0
# Annotated tag object from git ls-remote refs/tags/v6.21.0
XMRIG_TAG_OBJECT=8084ff37a5c8935c649a2e362da0fe570c79a2c2

OPENSSL_VERSION=3.0.15
OPENSSL_TARBALL=openssl-3.0.15.tar.gz
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.0.15/openssl-3.0.15.tar.gz
OPENSSL_SHA256=23c666d0edf20f14249b3d8f0368acaee9ab585b09e1de82107c66e1f3ec9533
OPENSSL_LICENSE=Apache-2.0

LIBUV_VERSION=1.48.0
LIBUV_TARBALL=libuv-v1.48.0.tar.gz
LIBUV_URL=https://dist.libuv.org/dist/v1.48.0/libuv-v1.48.0.tar.gz
LIBUV_SHA256=7f1db8ac368d89d1baf163bac1ea5fe5120697a73910c8ae6b2fffb3551d59fb
LIBUV_LICENSE=MIT

ANDROID_API=24
ANDROID_ABI=arm64-v8a
ANDROID_TRIPLE=aarch64-linux-android
MARCH_FLAGS="-O3 -march=armv8-a+crypto -ffast-math"
REQUIRED_CPU_INSTRUCTIONS="armv8-a crypto"
# Engine libc symbols (getifaddrs/preadv) need API 24+; keep app minSdk aligned.

# Feature flags written into CMake and the capability manifest.
WITH_HTTP=ON
WITH_TLS=ON
WITH_BENCHMARK=ON
WITH_HWLOC=OFF
WITH_OPENCL=OFF
WITH_CUDA=OFF
